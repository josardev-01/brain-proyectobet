# Copia este archivo como .env y completa únicamente los proveedores a probar.
# Nunca publiques claves reales.
API_FOOTBALL_KEY=
SPORTMONKS_TOKEN=
GOAL_API_KEY=
APIFOOTBALL_KEY=

# Opcional: entrega de alertas. No es necesario para recolectar ni hacer backtesting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aplicacion. SQLite permite desarrollo inmediato; PostgreSQL es el destino productivo.
DATABASE_URL=sqlite:///./data/projectbet.db
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
JWT_SECRET=replace-with-a-long-random-secret
